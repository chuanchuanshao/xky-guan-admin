{
  "rewrites": [
    { "source": "/", "destination": "http://124.221.93.94/" },
    { "source": "/:path*", "destination": "http://124.221.93.94/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
